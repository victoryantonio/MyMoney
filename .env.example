# ─────────────────────────────────────────
# MyMoney — Environment Variables Template (v2)
# Stack: Supabase + FastAPI backend + Node bot + Flutter app
# Copy this file to .env and fill in the values. Backend and bot both read
# this root file during local development; Flutter receives the same values
# through --dart-define at build/run time.
# NEVER commit .env to the repository.
# ─────────────────────────────────────────

# ── Supabase (WAJIB) ─────────────────────
# Dari dashboard supabase.com → Project Settings → API
# Project URL = base URL saja (TANPA suffix /rest/v1/ — SDK menambahkannya sendiri)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# KOSONGKAN untuk project baru (RS256): verifikasi token memakai JWKS public
# keys dari https://<ref>.supabase.co/auth/v1/.well-known/jwks.json (di-fetch
# otomatis di Fase 1). "Legacy JWT Secret" (HS256) HANYA untuk project lama.
SUPABASE_JWT_SECRET=

# ── Database (Supabase Postgres) ──────────
# SQLAlchemy URL. Runtime: Transaction pooler (port 6543).
# Migration (alembic): Session pooler (port 5432) atau direct.
# Ambil dari Project Settings → Database → Connection string
# Pooler (IPv4) — host direct db.<ref> IPv6-only, tidak bisa dari server ini.
# Session pooler port 5432 untuk migration; transaction pooler 6543 untuk runtime.
# Driver psycopg v3 → prefix WAJIB postgresql+psycopg://
DATABASE_URL=

# ── LLM — env-driven  gateway call_llm) ──
# Isi minimal SATU penyedia. OpenRouter (free tier) direkomendasikan;
# DeepSeek sebagai cadangan. Pemilihan lewat LLM_PROVIDER.
LLM_PROVIDER=auto   # auto | openrouter | deepseek

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
# Model default free tier (ARCHITECTURE §3.4) — override via env
LLM_TEXT_MODEL=deepseek-v4-flash
LLM_VISION_MODEL=deepseek-v4-flash-vision-exp
# Fallback chain (dipisah koma, dicoba berurutan)
LLM_TEXT_FALLBACK=meta-llama/llama-3.3-70b-instruct:free,openrouter/free

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
# Contoh DeepSeek:
# LLM_TEXT_MODEL=deepseek-v4-flash
# LLM_VISION_MODEL=deepseek-v4-flash-vision-exp

# ── Telegram Bot (service bot/ — Node/Telegraf) ──
# Dari @BotFather: https://t.me/botfather
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── Service-to-service (bot → backend) ──
# Token khusus agar bot Node dapat memanggil REST API backend
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
BOT_SERVICE_TOKEN=

# URL publik service bot (target setWebhook; Railway/Render setelah deploy,
# http://localhost:3000 saat dev). Backend memakainya di
# POST /api/telegram/register-webhook.
BOT_PUBLIC_URL=

# ── App Settings ──
APP_ENV=development
# URL publik backend (Railway/Render setelah deploy; localhost saat dev)
APP_BASE_URL=
PORT=8000

# ── Flutter / Web (build-time, BUKAN runtime backend) ──
# Dipakai saat build app via:
#   --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────
# v1 (legacy) — referensi saja, TIDAK dipakai v2
# ─────────────────────────────────────────
# DB_HOST=db / DB_PORT=5432 / DB_NAME=mymoney / DB_USER=mymoney_user / DB_PASSWORD=...
# JWT_SECRET_KEY=... / JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15 / JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# CLOUDFLARE_TUNNEL_TOKEN=...
