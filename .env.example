# ─────────────────────────────────────────
# MyMoney — Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to the repository.
# ─────────────────────────────────────────

# PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_NAME=mymoney
DB_USER=mymoney_user
DB_PASSWORD=change_me_strong_password

# SQLAlchemy database URL (assembled from above)
DATABASE_URL=postgresql+psycopg://mymoney_user:change_me_strong_password@db:5432/mymoney

# JWT
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=change_me_generate_random_hex_64_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# OpenRouter (single gateway for all LLM calls)
# Get your key at https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Telegram Bot
# Get from @BotFather: https://t.me/botfather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_WEBHOOK_SECRET=change_me_random_secret_string

# App Settings
APP_ENV=development
# The public HTTPS URL of your backend (e.g. your Cloudflare Tunnel URL)
APP_BASE_URL=https://your-tunnel-domain.trycloudflare.com

# Cloudflare Tunnel
# Token from Cloudflare Zero Trust Dashboard (Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...placeholder_tunnel_token...
